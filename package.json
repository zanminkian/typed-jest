{
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "install": "pnpm build",
    "prepare": "git-validator install",
    "release": "pnpm build && changeset publish",
    "style": "git-validator",
    "style:update": "git-validator -u",
    "test": "pnpm style"
  },
  "devDependencies": {
    "@changesets/cli": "2.27.8",
    "git-validator": "0.20.9",
    "typed-jest": "workspace:*",
    "typescript": "5.5.4"
  },
  "packageManager": "pnpm@8.15.4",
  "engines": {
    "node": ">=16.0.0",
    "pnpm": "^8.0.0"
  }
}
